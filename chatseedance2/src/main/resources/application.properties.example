spring.application.name=chatseedance2

spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:chatimg2}?tcpKeepAlive=true&connectTimeout=10&socketTimeout=120&ApplicationName=chatseedance2
spring.datasource.username=${DB_USER:postgres}
spring.datasource.password=${DB_PASSWORD:}
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false

spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.table=chatseedance2_schema_history
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0

app.seedance.api.url=${SEEDANCE_API_URL:https://www.ai.bagege.cn/openai/v1}
app.seedance.api.key=${SEEDANCE_API_KEY:}
app.seedance.api.model=${SEEDANCE_API_MODEL:ty-me-sd20-933}
app.seedance.api.connect-timeout-ms=${SEEDANCE_CONNECT_TIMEOUT_MS:30000}
app.seedance.api.read-timeout-ms=${SEEDANCE_READ_TIMEOUT_MS:120000}
app.seedance.api.model-cache-ms=${SEEDANCE_MODEL_CACHE_MS:300000}

app.video.debounce-window-ms=${VIDEO_DEBOUNCE_WINDOW_MS:3000}
app.video.poll-interval-ms=${VIDEO_POLL_INTERVAL_MS:5000}
app.video.poll-delayed-interval-ms=${VIDEO_POLL_DELAYED_INTERVAL_MS:30000}
app.video.poll-batch-size=${VIDEO_POLL_BATCH_SIZE:50}
app.video.task-lock-ttl-ms=${VIDEO_TASK_LOCK_TTL_MS:1500000}
app.video.recovery-enabled=${VIDEO_RECOVERY_ENABLED:true}
app.video.executor.core-size=${VIDEO_EXECUTOR_CORE_SIZE:2}
app.video.executor.max-size=${VIDEO_EXECUTOR_MAX_SIZE:8}
app.video.executor.queue-capacity=${VIDEO_EXECUTOR_QUEUE_CAPACITY:100}
app.video.storage-path=${VIDEO_STORAGE_PATH:./video-media/}
app.video.public-base-url=${VIDEO_PUBLIC_BASE_URL:}
app.video.max-image-bytes=${VIDEO_MAX_IMAGE_BYTES:20971520}
app.video.max-video-bytes=${VIDEO_MAX_VIDEO_BYTES:524288000}
app.video.max-audio-bytes=${VIDEO_MAX_AUDIO_BYTES:104857600}

app.security.allowed-origins=${APP_ALLOWED_ORIGINS:http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175}

server.port=${APP_PORT:8081}
