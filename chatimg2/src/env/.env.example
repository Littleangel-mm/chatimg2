# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatimg2
DB_USER=postgres
DB_PASSWORD=

# Image generation provider
API_URL=https://www.maitokens.top/v1
API_KEY=
API_MODEL_TEXT2IMG=gpt-image-2
API_MODEL_IMG2IMG=gpt-image-2
IMAGE_DOWNLOAD_CONNECT_TIMEOUT_MS=30000
IMAGE_DOWNLOAD_READ_TIMEOUT_MS=120000
GENERATION_EXECUTOR_CORE_SIZE=2
GENERATION_EXECUTOR_MAX_SIZE=8
GENERATION_EXECUTOR_QUEUE_CAPACITY=100

# Seedance video generation provider
SEEDANCE_API_URL=https://www.ai.bagege.cn/openai/v1
SEEDANCE_API_KEY=
SEEDANCE_API_MODEL=ty-p-sd2-fast-720
SEEDANCE_CONNECT_TIMEOUT_MS=30000
SEEDANCE_READ_TIMEOUT_MS=1200000
SEEDANCE_MODEL_CACHE_MS=300000

# Video generation concurrency and recovery
VIDEO_DEBOUNCE_WINDOW_MS=3000
VIDEO_POLL_INTERVAL_MS=5000
VIDEO_POLL_DELAYED_INTERVAL_MS=30000
VIDEO_POLL_BATCH_SIZE=50
VIDEO_TASK_LOCK_TTL_MS=1500000
VIDEO_RECOVERY_ENABLED=true
VIDEO_EXECUTOR_CORE_SIZE=2
VIDEO_EXECUTOR_MAX_SIZE=8
VIDEO_EXECUTOR_QUEUE_CAPACITY=100
VIDEO_STORAGE_PATH=./video-media/
VIDEO_PUBLIC_BASE_URL=https://your-public-domain.example.com

# QQ Mail SMTP authorization code
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Runtime behavior
GENERATION_RECOVERY_ENABLED=true
INSPIRATION_DOWNLOAD_IMAGES=true
INSPIRATION_SCHEDULE_ENABLED=true
APP_PORT=8080
