# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatimg2
DB_USER=postgres
DB_PASSWORD=

# Image generation provider
API_URL=https://wcf.maitokens.com
API_KEY=
API_MODEL_TEXT2IMG=gpt-image-2
API_MODEL_IMG2IMG=gpt-image-2
API_MAITOKENS_WCF_COMPAT=true
IMAGE_DOWNLOAD_CONNECT_TIMEOUT_MS=30000
IMAGE_DOWNLOAD_READ_TIMEOUT_MS=120000
GENERATION_EXECUTOR_CORE_SIZE=2
GENERATION_EXECUTOR_MAX_SIZE=8
GENERATION_EXECUTOR_QUEUE_CAPACITY=100

# QQ Mail SMTP authorization code
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Runtime behavior
GENERATION_RECOVERY_ENABLED=true
INSPIRATION_DOWNLOAD_IMAGES=true
INSPIRATION_SCHEDULE_ENABLED=true
